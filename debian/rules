#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1


# see FEATURE AREAS in dpkg-buildflags(1)
#export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
#export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
# package maintainers to append LDFLAGS
#export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

export DEB_BUILD_OPTIONS = noautodbgsym
export PKG_CONFIG_ALLOW_CROSS = 1

%:
	dh $@ --buildsystem cargo

override_dh_auto_clean:
	dh_auto_clean -- \
		--offline

execute_before_dh_auto_configure:
	touch debian/cargo-checksum.json

execute_after_dh_auto_configure:
# Restore the lock file removed by dh-cargo.
	git restore Cargo.lock
# Keep using Cargo.lock.
	sed -i '/\[build\]/,$$!d' debian/cargo_home/config

override_dh_auto_install:
	dh_auto_install -- \
		--locked

override_dh_auto_test:

execute_after_dh_install:
	mv debian/apt-transport-blob/usr/bin/blob \
		debian/apt-transport-blob/usr/lib/apt-transport-blob
	rmdir debian/apt-transport-blob/usr/bin
